# ==============================================================================
# FanClub Environment Configuration Template
# Copy this file to '.env' and customize values for local or production use.
# NEVER commit the actual '.env' file to version control.
# ==============================================================================

# Flask Session & Security Key (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=generate-a-secure-random-32-byte-secret-key-here

# Database Connection URL:
# Local SQLite: sqlite:///fanclub.db
# Production PostgreSQL: postgresql://username:password@hostname:5432/databasename
DATABASE_URL=sqlite:///fanclub.db

# Application Environment (development / production)
FLASK_ENV=development
PORT=5000

# Initial Administrator Provisioning (Optional - set to auto-create admin on startup)
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD=your_secure_admin_password_min_8_chars
ADMIN_NAME=Platform Administrator
ADMIN_PHONE=9800000000

# Optional Payment Gateway Configuration (Leave blank for 'Pay at Turf Desk' direct booking)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
